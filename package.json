{
  "name": "surestop",
  "version": "0.1.0",
  "private": true,
  "description": "SureStop: browser robot simulation with terminal target verification and reproducible evaluation.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:diagnostics": "SURESTOP_DIAGNOSTICS=1 next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "aggregate": "esbuild scripts/aggregate.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.cache/aggregate.mjs && node .cache/aggregate.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@tensorflow-models/coco-ssd": "2.2.3",
    "@tensorflow/tfjs-backend-cpu": "4.22.0",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@tensorflow/tfjs-backend-webgl": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "geist": "1.8.1",
    "next": "16.4.3",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
